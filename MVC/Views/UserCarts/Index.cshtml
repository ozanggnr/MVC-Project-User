@model IEnumerable<UserCartItem>
@* Generated from Custom MVC Template. *@
@* Model namespace using directive should be added to _ViewImports.cshtml. *@

@{
    var containerDivClass = "container"; // "container-fluid" can be used for full width
}
@{
    /*
    ViewBag and ViewData are the same collection (dictionary).
    They carry extra data other than the model from a controller action to its view, or between views.
    The value assigned will be shown in Views\Shared\_Layout.cshtml view's title tag of the head tag.
    */
    ViewData["Title"] = "User Cart";
}

<div class="@containerDivClass">
    <h1>@ViewData["Title"]</h1>
    <hr />
</div>

@if (Model is not null)
{
    <div class="@containerDivClass">
        <div class="row">
            <div class="col-12 text-danger">
                @*
                TempData is used to carry extra data to the redirected controller action's view.
                *@
                @TempData["Message"]
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-10 text-success">
                @Model.Count() user(s) in cart.
            </div>
            <div class="col-2 text-end">
                @if (Model.Any())
                {
                    <form asp-action="ClearCart" method="post" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger btn-sm">Clear Cart</button>
                    </form>
                }
            </div>
        </div>
        @if (Model.Any())
        {
            <table class="table table-striped table-hover">
                <thead class="table-secondary">
                    <tr>
                        <th>
                            @Html.DisplayNameFor(model => model.UserName)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.FullName)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.RegistrationDateF)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.ScoreF)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Group)
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.UserName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.FullName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.RegistrationDateF)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.ScoreF)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Group)
                            </td>
                            <td class="text-end">
                                <form asp-action="RemoveFromCart" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@item.UserId" />
                                    <button type="submit" class="btn btn-danger btn-sm">Remove</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-info">
                Your cart is empty. <a asp-controller="Users" asp-action="Index">Add users to cart</a>
            </div>
        }
    </div>
}

